{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "netipar/laravel-consent",
    "description": "Headless cookie-consent for Laravel: versioned consent cookie, server-side API and Blade directive, framework-free JS core with Google Consent Mode v2, unstyled Alpine/Livewire and Vue 3 adapters.",
    "keywords": [
        "laravel",
        "netipar",
        "cookie",
        "consent",
        "gdpr",
        "cookie-consent",
        "consent-mode",
        "alpine",
        "livewire",
        "vue"
    ],
    "homepage": "https://github.com/NETipar/laravel-consent",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/NETipar/laravel-consent/issues",
        "source": "https://github.com/NETipar/laravel-consent",
        "docs": "https://github.com/NETipar/laravel-consent#readme",
        "security": "https://github.com/NETipar/laravel-consent/security/policy"
    },
    "authors": [
        {
            "name": "NETipar",
            "email": "dev@netipar.hu",
            "homepage": "https://netipar.hu",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/cache": "^12.0||^13.0",
        "illuminate/contracts": "^12.0||^13.0",
        "illuminate/database": "^12.0||^13.0",
        "illuminate/http": "^12.0||^13.0",
        "illuminate/routing": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0",
        "illuminate/translation": "^12.0||^13.0",
        "illuminate/validation": "^12.0||^13.0",
        "illuminate/view": "^12.0||^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pao": "^1.0",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6",
        "pestphp/pest-plugin-laravel": "^4.1",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "NETipar\\Consent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NETipar\\Consent\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --memory-limit=2G"
        ],
        "test:types": [
            "vendor/bin/pest --type-coverage --min=100 --memory-limit=2G"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test:coverage": [
            "vendor/bin/pest --coverage"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "NETipar\\Consent\\ConsentServiceProvider"
            ],
            "aliases": {
                "Consent": "NETipar\\Consent\\Facades\\Consent"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
