{
    "private": true,
    "scripts": {
        "build": "pnpm -r run build",
        "build:core": "pnpm --filter @netipar/consent-core run build",
        "build:vue3": "pnpm --filter @netipar/consent-vue3 run build",
        "build:alpine": "pnpm --filter @netipar/consent-alpine run build",
        "publish:all": "pnpm run build && pnpm -r publish --no-git-checks",
        "test": "pnpm build:core && vitest run",
        "test:watch": "vitest",
        "test:coverage": "pnpm build:core && vitest run --coverage",
        "typecheck": "pnpm build:core && pnpm -r exec tsc --noEmit"
    },
    "devDependencies": {
        "@vitest/coverage-v8": "^5.0.3",
        "@vue/test-utils": "^2.4.6",
        "esbuild": "^0.28",
        "happy-dom": "^20.9.0",
        "tsup": "^8.5.0",
        "typescript": "^6.0.3",
        "vitest": "^5.0.3",
        "vue": "^3.5"
    }
}
